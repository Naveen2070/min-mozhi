{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Min-Mozhi",
  "scopeName": "source.mimz",
  "comment": "All three keyword flavors (English, Tanglish, Tamil) highlight identically — spellings must stay in sync with keywords.toml; tests/grammar_sync.rs enforces it. Custom (?<![\\p{L}\\p{N}_]) boundaries are used instead of \\b so Tamil-script keywords match correctly.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#module-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#bundle-declaration" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-control" },
    { "include": "#keywords-constant" },
    { "include": "#keywords-logical-words" },
    { "include": "#reserved-words" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.mimz", "match": "//.*$" },
        { "name": "comment.block.mimz", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mimz",
      "begin": "\"",
      "end": "\""
    },
    "module-declaration": {
      "comment": "module / thoguthi / தொகுதி followed by the module name",
      "match": "(?<![\\p{L}\\p{N}_])(module|thoguthi|தொகுதி)(?![\\p{L}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.module.mimz" },
        "2": { "name": "entity.name.type.module.mimz" }
      }
    },
    "enum-declaration": {
      "comment": "enum / vagai / வகை followed by the enum name",
      "match": "(?<![\\p{L}\\p{N}_])(enum|vagai|வகை)(?![\\p{L}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.enum.mimz" },
        "2": { "name": "entity.name.type.enum.mimz" }
      }
    },
    "bundle-declaration": {
      "comment": "bundle / kattai / கட்டை followed by the bundle name",
      "match": "(?<![\\p{L}\\p{N}_])(bundle|kattai|கட்டை)(?![\\p{L}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "storage.type.bundle.mimz" },
        "2": { "name": "entity.name.type.bundle.mimz" }
      }
    },
    "keywords-declaration": {
      "comment": "declaration keywords, all flavors (incl. the `include` alias of import, `function` alias of fn)",
      "name": "storage.type.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(module|thoguthi|தொகுதி|in|ulleedu|உள்ளீடு|out|veliyeedu|வெளியீடு|wire|kambi|கம்பி|reg|pathivedu|பதிவேடு|mem|ninaivagam|நினைவகம்|clock|thudippu|துடிப்பு|reset|meettamai|மீட்டமை|async|otthisaivatra|ஒத்திசைவற்ற|sync|othisai|ஒத்திசை|enum|vagai|வகை|bundle|kattai|கட்டை|let|amai|அமை|const|maarili|மாறிலி|import|include|serkka|சேர்க்க|test|sodhanai|சோதனை|for|kaaga|க்காக|tick|kanam|கணம்|expect|uruthisei|உறுதிசெய்|sim|paavnai|பாவனை|bind|inai|இணை|speed|vegam|வேகம்|fn|function|saarbu|சார்பு|extern|anniya|அன்னிய)(?![\\p{L}\\p{N}_])"
    },
    "keywords-control": {
      "comment": "control-flow keywords, all flavors",
      "name": "keyword.control.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(if|enil|எனில்|else|illaiyenil|இல்லையெனில்|match|thernthedu|தேர்ந்தெடு|on|pothu|போது|rise|yetram|ஏற்றம்|fall|irakkam|இறக்கம்|repeat|meendum|மீண்டும்|default|iyalbu|இயல்பு|syntax|ilakkanam|இலக்கணம்|thamizh|தமிழ்|return|thirumbu|திரும்பு|loop|suzhal|சுழல்|foreach|ovvondraga|ஒவ்வொன்றாக|assert|valiyuruthu|வலியுறுத்து|cover|alavidu|அளவிடு)(?![\\p{L}\\p{N}_])"
    },
    "keywords-constant": {
      "name": "constant.language.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(true|mei|மெய்|false|poi|பொய்)(?![\\p{L}\\p{N}_])"
    },
    "keywords-logical-words": {
      "comment": "word aliases of && || ! (G1-x)",
      "name": "keyword.operator.logical.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(and|mattrum|மற்றும்|or|alladhu|அல்லது|not|alla|அல்ல)(?![\\p{L}\\p{N}_])"
    },
    "reserved-words": {
      "comment": "reserved for future features — using them is a compile error",
      "name": "invalid.illegal.reserved.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(inout|struct|secret|declassify|pipeline|interface|chan|prove|await|fixed|requires|ensures)(?![\\p{L}\\p{N}_])"
    },
    "types": {
      "comment": "universal vocabulary — never translated",
      "name": "support.type.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(bit|bits|signed|int|bool)(?![\\p{L}\\p{N}_])"
    },
    "builtins": {
      "comment": "the complete builtin list; only callables in the language",
      "name": "support.function.builtin.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(extend|trunc|signed|unsigned|min|max|abs)(?=\\()"
    },
    "numbers": {
      "name": "constant.numeric.mimz",
      "match": "(?<![\\p{L}\\p{N}_])(0[bB][01_?]+|0[xX][0-9a-fA-F_]+|[0-9][0-9_]*)(?![\\p{L}\\p{N}_])"
    },
    "operators": {
      "patterns": [
        {
          "comment": "wrapping arithmetic — the visible-overflow operators",
          "name": "keyword.operator.arithmetic.wrapping.mimz",
          "match": "\\+%|-%|\\*%"
        },
        {
          "comment": "register assignment",
          "name": "keyword.operator.assignment.reg.mimz",
          "match": "<-"
        },
        {
          "name": "keyword.operator.arrow.mimz",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.mimz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.mimz",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.mimz",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.mimz",
          "match": "\\+|-|\\*"
        },
        {
          "name": "keyword.operator.assignment.mimz",
          "match": "="
        }
      ]
    }
  }
}
