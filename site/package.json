{
  "name": "min-mozhi-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:wasm && astro build",
    "build:wasm": "cargo build -p mimz-wasm --manifest-path ../Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/lib/wasm ../target/wasm32-unknown-unknown/release/mimz_wasm.wasm",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "test:lib": "node src/lib/keywords.test.mjs && node src/lib/nav-map.test.mjs && node src/lib/rehype-code-copy.test.mjs && node src/lib/stats.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.6",
    "astro-pagefind": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
