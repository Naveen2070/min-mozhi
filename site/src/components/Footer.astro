---
// Site-wide footer. Four columns mirroring the three docs tracks plus the
// project links — on a 54-page docs site a single line throws away the one
// place every page ends.
//
// Dual MIT + Apache-2.0, matching Cargo.toml `license = "MIT OR Apache-2.0"`.
import Mascot from "./Mascot.astro";

const REPO = "https://github.com/Naveen2070/min-mozhi";
const AUTHOR = "https://naveenr.in";

const columns = [
  {
    title: "Learn",
    links: [
      { href: "/learn", label: "Learn the basics" },
      { href: "/lab", label: "Lab (beta)" },
      { href: "/guide/01-getting-started", label: "Getting started" },
      { href: "/playground", label: "Playground" },
    ],
  },
  {
    title: "Reference",
    links: [
      { href: "/guide", label: "Guide" },
      { href: "/guide/stdlib/readme", label: "Standard library" },
      { href: "/handbook", label: "Handbook (beta)" },
      { href: "/guide/12-cheatsheet", label: "Cheatsheet" },
    ],
  },
  {
    title: "Spec",
    links: [
      { href: "/spec", label: "Overview" },
      { href: "/spec/02-syntax-and-grammar", label: "Syntax & grammar" },
      { href: "/spec/03-keywords-trilingual", label: "Keywords" },
      { href: "/spec/06-editions", label: "Editions" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "/downloads", label: "Downloads" },
      { href: REPO, label: "GitHub" },
      { href: `${REPO}/blob/master/CHANGELOG.md`, label: "Changelog" },
      { href: `${REPO}/issues`, label: "Report an issue" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-cols">
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="u-eyebrow">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-base fg-muted">
      <span class="inline-flex items-center gap-2">
        <Mascot class="h-9 w-9 shrink-0" alt="" />
        <span class="ff-tamil" lang="ta">மின்மொழி</span> — Speak in Circuits · © 2026
        Naveen R · Licensed under
        <a href={`${REPO}/blob/master/LICENSE-MIT`}>MIT</a>
        <span aria-hidden="true">+</span>
        <a href={`${REPO}/blob/master/LICENSE-APACHE`}>Apache-2.0</a>
      </span>
      <span>
        Made with <span class="fg-accent" aria-hidden="true">♥</span> by
        <a href={AUTHOR}>Naveen R</a> · Built in Tamil Nadu 🇮🇳
      </span>
    </div>
  </div>
</footer>
