---
// Chapter navigation. Sections are computed by lib/docs.ts (getNav) and passed
// down by the Docs layout, so this component only renders — and the pager walks
// exactly the order shown here.
//
// The old hand-written learn↔handbook↔lab `crossLink` table is gone: the track
// grouping puts related sections in the same sidebar, so the cross-link is a
// consequence of the data rather than a lookup someone has to maintain.
import TrackSwitcher from "./TrackSwitcher.astro";
import type { NavSection } from "../lib/docs";

interface Props {
  current: string; // e.g. "guide/08-sequential-logic"
  sections: NavSection[];
  track: string;
}
const { current, sections, track } = Astro.props;
const key = current.toLowerCase();
---

<TrackSwitcher track={track} />

<nav aria-label="Documentation" class="text-sm" data-docs-nav>
  {
    sections.map((s) => (
      <details class="group mb-7" open>
        <summary
          class="fg-muted mb-2 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none flex items-center justify-between hover:opacity-80 transition-opacity"
          style="list-style: none;"
        >
          <span>
            {s.title}
            {s.beta && <span class="beta-pill">beta</span>}
          </span>
          <svg
            class="w-3 h-3 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </summary>
        <ul class="space-y-0.5 mt-2">
          {s.items.map((item) => (
            <li>
              <a
                href={`/${item.href}`}
                aria-current={
                  key === item.href.toLowerCase() ? "page" : undefined
                }
                class:list={[
                  "doc-link block rounded px-2 py-1",
                  { active: key === item.href.toLowerCase() },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</nav>

{/* With three sections open at once the active chapter can start below the
    fold. One line of script, only when the nav actually scrolls. Scoped to the
    .docs-aside copy on purpose: the mobile drawer (Task 8) renders a second
    Sidebar EARLIER in the DOM, and a bare querySelector would find that hidden
    copy on desktop and silently do nothing. */}
<script is:inline>
  (() => {
    const nav = document.querySelector(".docs-aside [data-docs-nav]");
    const active = nav && nav.querySelector('[aria-current="page"]');
    if (!active || !nav) return;
    const navBox = nav.getBoundingClientRect();
    const box = active.getBoundingClientRect();
    if (box.top < navBox.top || box.bottom > navBox.bottom) {
      active.scrollIntoView({ block: "center" });
    }
  })();
</script>

<style>
  .doc-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .doc-link:hover {
    color: var(--text);
    background-color: var(--bg-soft);
  }
  .doc-link.active {
    color: var(--accent);
    background-color: var(--bg-soft);
    font-weight: 600;
  }

  /* Hide the default marker for summary elements */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
