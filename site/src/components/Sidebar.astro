---
// Chapter navigation. The sections are computed by lib/docs.ts (getNav) and passed
// down by the Docs layout, so this component only renders — and so the pager walks
// exactly the order shown here.
import { sectionOf, type NavSection } from "../lib/docs";

interface Props {
  current: string; // e.g. "guide/04-signals"
  sections: NavSection[];
}
const { current, sections } = Astro.props;

// On the beta sections, offer the way across instead of listing every other
// section — Learn, Handbook and Lab are read together.
const section = sectionOf(current);
const crossLink =
  section === "learn"
    ? { href: "/handbook", label: "Handbook" }
    : section === "handbook"
      ? { href: "/learn", label: "Learn" }
      : section === "lab"
        ? { href: "/learn", label: "Learn" }
        : null;
---

<nav aria-label="Documentation" class="text-sm">
  {
    sections.map((s) => (
      <details class="group mb-7" open>
        <summary
          class="fg-muted mb-2 text-xs font-semibold uppercase tracking-wider cursor-pointer select-none flex items-center justify-between hover:opacity-80 transition-opacity"
          style="list-style: none;"
        >
          {s.title}
          <svg
            class="w-3 h-3 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </summary>
        <ul class="space-y-0.5 mt-2">
          {s.items.map((item) => (
            <li>
              <a
                href={`/${item.href}`}
                class:list={[
                  "doc-link block rounded px-2 py-1",
                  { active: current.toLowerCase() === item.href.toLowerCase() },
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }

  {
    crossLink && (
      <div class="cross-link">
        <a href={crossLink.href} class="doc-link block rounded px-2 py-1">
          {crossLink.label} &rarr;
        </a>
      </div>
    )
  }
</nav>

<style>
  .doc-link {
    color: var(--text-muted);
    text-decoration: none;
  }
  .doc-link:hover {
    color: var(--text);
    background-color: var(--bg-soft);
  }
  .doc-link.active {
    color: var(--accent);
    background-color: var(--bg-soft);
    font-weight: 600;
  }

  .cross-link {
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  /* Hide the default marker for summary elements */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
