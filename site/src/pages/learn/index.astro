---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";

// The Learn hub (site/content/learn/README.md) as the /learn landing page.
const [entry] = await getCollection("learnIndex");
const { Content, headings } = await render(entry);
---

<Docs title={entry.data.title} description={entry.data.description} current="learn" headings={headings}>
  <Content />
</Docs>
