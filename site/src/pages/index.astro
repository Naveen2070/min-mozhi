---
import { readFileSync } from "node:fs";
import path from "node:path";
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Band from "../components/Band.astro";
import Stat from "../components/Stat.astro";
import Mascot from "../components/Mascot.astro";
import HeroCompile from "../components/HeroCompile.tsx";
import type { HeroFlavor } from "../components/HeroCompile.tsx";
import SafeByDefault from "../components/features/SafeByDefault.tsx";
import Trilingual from "../components/features/Trilingual.tsx";
import { siteStats } from "../lib/stats.mjs";

// repo root is the parent of site/ (cwd during astro build/dev). Plain fs read,
// not `new URL(..., import.meta.url)` — Vite would treat that as an asset import.
const repoRoot = path.resolve(process.cwd(), "..");
const read = (rel: string) =>
  readFileSync(path.join(repoRoot, rel), "utf-8").trimEnd();

// Strip the leading comment header: the hero shows code, not a preamble.
const stripHeader = (code: string) =>
  code
    .split("\n")
    .reduce<{ out: string[]; head: boolean }>(
      (acc, line) => {
        if (acc.head && (line.trim().startsWith("//") || line.trim() === "")) {
          return acc;
        }
        return { out: [...acc.out, line], head: false };
      },
      { out: [], head: true },
    )
    .out.join("\n");

// English / Tanglish / Tamil counters differ ONLY in keywords — same module
// name, same signal names — so all three genuinely emit byte-identical Verilog.
// (examples/tamil-pure/kanakki.mimz does NOT: its identifiers are Tamil too, so
// it emits `module kannakki`. It gets its own honest section below rather than
// a false "identical" claim.)
const flavors: HeroFlavor[] = [
  {
    key: "english",
    label: "English",
    source: stripHeader(read("examples/english/counter.mimz")),
  },
  {
    key: "tanglish",
    label: "Tanglish",
    source: stripHeader(read("examples/tanglish/counter.mimz")),
  },
  {
    key: "tamil",
    label: "தமிழ்",
    tamil: true,
    source: stripHeader(read("examples/tamil/counter.mimz")),
  },
];

// The static pane content: what these three really compile to, straight from
// the golden file the test suite keeps honest. The file carries an internal
// audit note (BUG-65) meant for compiler maintainers — strip it before display,
// including from the island's serialized props, which Astro embeds in the HTML.
const golden = read("tests/golden/counter.v")
  .split("\n")
  .filter((line) => !line.trim().startsWith("// NOTE (BUG"))
  .join("\n");

const pureTamil = stripHeader(read("examples/tamil-pure/kanakki.mimz"));

const stats = siteStats();

const mimzGrammar = JSON.parse(
  readFileSync(
    path.join(repoRoot, "editors/vscode/syntaxes/mimz.tmLanguage.json"),
    "utf-8",
  ),
);
const mimzLang = { ...mimzGrammar, name: "mimz" };
const shikiThemes = { light: "github-light", dark: "github-dark" } as const;

// What the checker rejects. Each line is a real compile-time error, not a
// style guideline.
const refusals = [
  ["Inferred latches", "An incomplete branch that would synthesise a latch."],
  ["Silent truncation", "Assigning a wider value into a narrower signal."],
  ["Multiple drivers", "Two sources writing one signal."],
  ["Uninitialized registers", "A `reg` with no reset value."],
  ["Signed/unsigned mixing", "Comparing or combining the two by accident."],
  ["Undriven outputs", "An `out` port nothing ever assigns."],
];

// JSON-LD: describe the project as open-source software for richer search results.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Min-Mozhi",
  alternateName: "மின்மொழி",
  description:
    "A modern, safe-by-default hardware description language — built to teach digital design, and a Tamil-rooted HDL.",
  url: "https://mimz.naveenr.in",
  codeRepository: "https://github.com/Naveen2070/min-mozhi",
  programmingLanguage: ["Rust", "Verilog"],
  license: "https://spdx.org/licenses/MIT.html",
  author: { "@type": "Person", name: "Naveen R" },
  softwareVersion: stats.version,
};
---

<Base>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <Nav />

  <main>
    <!-- Hero -->
    <section class="page hero-section">
      {/* Copy and the live pane sit side by side ≥1024px — the pane used to
          stack below the copy, leaving the whole right half of the fold
          empty. */}
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="u-eyebrow">
            <span class="ff-tamil" lang="ta">மின்மொழி</span> · the language of electricity
          </p>
          <h1 class="u-display fg">
            <span class="hero-title-line1">A safe-by-default HDL.</span><br />
            <span class="spark-gradient bg-clip-text text-transparent"
              >Written in your language.</span
            >
          </h1>
          <p class="hero-sub fg-muted">
            Reads like Go. Checked like Rust. Speaks English, Tanglish and Tamil —
            and compiles to plain, synthesizable Verilog.
          </p>
          <div class="hero-cta">
            <a href="/learn" class="btn-primary">Start learning</a>
            <a href="#try" class="btn-outline">Try it in the browser</a>
          </div>
          <p class="hero-install fg-muted">
            Prebuilt binaries for {stats.version} —
            <a href="/downloads">Downloads</a> · or build from source with{" "}
            <code>cargo build</code>
          </p>
          <Mascot
            variant="full"
            class="hero-mascot-watermark"
            alt=""
            loading="eager"
          />
        </div>

        <div id="try" class="hero-live">
          <HeroCompile client:visible flavors={flavors} golden={golden} />
          <p class="hero-note fg-muted">
            The real compiler, running in this tab. Switch the flavor: only the
            keywords change, and the emitted Verilog stays byte-identical.
          </p>
        </div>
      </div>
    </section>

    <!-- Proof -->
    <Band class="band-proof">
      <div class="stat-row">
        <Stat value={stats.version} label="current release" />
        <Stat value={String(stats.tests)} label="passing tests" />
        <Stat value={String(stats.examples)} label="example programs" />
        <Stat value={String(stats.chapters)} label="documentation chapters" />
        <Stat value={String(stats.safetyPasses)} label="safety passes" />
      </div>
      <p class="band-foot">
        Beta · MIT or Apache-2.0 · built in Tamil Nadu 🇮🇳
      </p>
    </Band>

    <!-- What it refuses to compile -->
    <section class="page">
      <div class="split">
        <div>
          <p class="u-eyebrow">Safety</p>
          <h2 class="sec-title">What it refuses to compile</h2>
          <p class="fg-muted sec-lead">
            Every one of these is a compile-time error with a stable
            <code>E</code>-code and an explanation, not a warning you learn to
            scroll past.
          </p>
          <ul class="refusals">
            {
              refusals.map(([name, why]) => (
                <li>
                  <strong class="fg">{name}</strong>
                  <span class="fg-muted">{why}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="bd bg-soft rounded-xl border p-6 lg:p-8">
          <SafeByDefault client:visible />
        </div>
      </div>
    </section>

    <!-- Trilingual, honestly -->
    <Band>
      <div class="split">
        <div class="bd bg-soft rounded-xl border p-6 lg:p-8">
          <Trilingual client:visible />
        </div>
        <div>
          <p class="u-eyebrow">Trilingual</p>
          <h2 class="sec-title">One grammar, three keyword sets</h2>
          <p class="fg-muted sec-lead">
            The flavors above are keyword skins over one grammar, so the same
            design reads natively in your language and builds the same hardware.
            <code>mimz translate</code> converts a codebase between them losslessly.
          </p>
          <p class="fg-muted sec-lead">
            Pure Tamil goes further: identifiers are Tamil too, and the compiler
            transliterates them into readable ASCII Verilog. The output is not
            byte-identical to the English version — the names really did change —
            it is the same circuit.
          </p>
          <Code code={pureTamil} lang={mimzLang} themes={shikiThemes} />
        </div>
      </div>
    </Band>

    <!-- Tooling -->
    <section class="page">
      <p class="u-eyebrow">Tooling</p>
      <h2 class="sec-title">One binary, batteries included</h2>
      <div class="cards">
        <a class="card" href="/guide/11-toolchain">
          <h3>Simulator</h3>
          <p>
            Run clocked and combinational designs, sweep inputs, and emit
            deterministic VCD waveforms without an external tool.
          </p>
        </a>
        <a class="card" href="/guide/01-getting-started">
          <h3>Verilog emitter</h3>
          <p>
            Clean, human-readable, synthesizable Verilog-2005. Drop it into
            Yosys, nextpnr or a vendor flow with no lock-in.
          </p>
        </a>
        <a class="card" href="/guide/11-toolchain">
          <h3>Language server</h3>
          <p>
            Live diagnostics and hover in VS Code, driven by the same compiler
            that builds your design.
          </p>
        </a>
        <a class="card" href="/lab">
          <h3>Lab <span class="beta-pill">beta</span></h3>
          <p>
            Graded, in-browser lessons. Write a module, press verify, and the
            real compiler checks your work.
          </p>
        </a>
      </div>
    </section>

    <!-- Get started -->
    <Band class="band-end">
      <h2 class="sec-title">Start where you are</h2>
      <div class="cards">
        <a class="card" href="/learn">
          <h3>New to hardware</h3>
          <p>Learn what an HDL is, then build up to real designs.</p>
        </a>
        <a class="card" href="/guide/01-getting-started">
          <h3>Know an HDL already</h3>
          <p>Jump into the guide and have a counter compiling in minutes.</p>
        </a>
        <a class="card" href="/spec">
          <h3>Want the details</h3>
          <p>Read the grammar, the checker rules and the editions.</p>
        </a>
      </div>
    </Band>
  </main>

  <Footer />
</Base>
