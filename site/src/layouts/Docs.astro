---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import Pager from "../components/Pager.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Callout from "../components/Callout.astro";
import Toc from "../components/Toc.astro";
import TocSpy from "../components/TocSpy.tsx";
import LiveWaveformMount from "../components/LiveWaveformMount.tsx";
import { getNav, getPager, sectionOf, sectionName } from "../lib/docs";
import { readFileSync, readdirSync } from "node:fs";
import { execFileSync } from "node:child_process";
import path from "node:path";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  current: string; // e.g. "guide/04-signals"
  description?: string;
  /** From `render(entry)`. Drives the on-this-page rail. */
  headings?: MarkdownHeading[];
}

// Read stdlib examples for the interactive waveforms
const stdDir = path.resolve(process.cwd(), "../examples/english/std");
const stdSources: Record<string, string> = {};
try {
  for (const file of readdirSync(stdDir)) {
    if (file.endsWith(".mimz")) {
      stdSources[file.replace(".mimz", "")] = readFileSync(path.join(stdDir, file), "utf-8");
    }
  }
} catch (e) {
  // Graceful fallback during dev if examples aren't found
}

const { title, current, description, headings = [] } = Astro.props;

const section = sectionOf(current);
const SECTION_BLURB: Record<string, string> = {
  guide: "Learn the language step by step.",
  spec: "The language specification.",
  learn: "An introduction to hardware description languages, and to Min-Mozhi.",
  handbook: "Every keyword, operator, quirk and command, in one reference.",
  lab: "Practice Min-Mozhi in the browser, one small exercise at a time.",
};
const isBeta =
  section === "learn" || section === "handbook" || section === "lab";
const metaDescription =
  description ??
  `${title} — Min-Mozhi ${sectionName(section)}. ${SECTION_BLURB[section]}${isBeta ? " (Beta.)" : ""}`;

// Sidebar sections + the pager sequence come from one place, so they agree.
const { sections, sequence, track } = await getNav(current);
const { prev, next } = getPager(sequence, current);

// The rail is only worth a column when there is something to list — the same
// rule Toc.astro applies, so the grid and the rail agree.
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length >= 2;

// The author-honesty disclaimer rides EVERY Learn AND Lab page (lab plan D8:
// lesson 00 makes general-HDL claims, so the banner follows the section, not a
// curated subset) — the hub gets the full box, each page a one-line banner.
// Keyed off the section alone: no per-file flag to set, so a new chapter cannot
// silently ship without it.
const isHonesty = section === "learn" || section === "lab";
const isHonestyHub = current === section;

// Where each section's markdown actually lives, so "edit this page" points at
// the real file. Mirrors content.config.ts — guide/spec mirror repo docs, the
// beta sections are site-local originals.
function sourcePath(current: string): string {
  const s = sectionOf(current);
  const rest = current.slice(s.length + 1); // "" on a hub
  if (s === "guide") {
    return rest ? `docs/guide/${rest}.md` : "docs/guide/README.md";
  }
  if (s === "spec") {
    return rest ? `spec/${rest}.md` : "spec/README.md";
  }
  return rest
    ? `site/content/${s}/${rest}.md`
    : `site/content/${s}/README.md`;
}

const relSource = sourcePath(current);
const editUrl = `https://github.com/Naveen2070/min-mozhi/blob/master/${relSource}`;

// Last commit date for that file. Vercel may build from a shallow clone with no
// history, and a contributor may build from a tarball with no git at all — both
// return null and the line simply does not render. Never guess from mtime: a
// fresh checkout stamps every file with the clone time.
let updated: string | null = null;
try {
  const iso = execFileSync(
    "git",
    ["log", "-1", "--format=%cI", "--", relSource],
    { cwd: path.resolve(process.cwd(), ".."), encoding: "utf-8" },
  ).trim();
  updated = iso
    ? new Date(iso).toLocaleDateString("en-GB", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })
    : null;
} catch {
  updated = null;
}

// JSON-LD breadcrumb: Home › <Section> › this page.
const site = Astro.site ?? new URL("https://mimz.naveenr.in");
const crumbs = [
  { name: "Home", url: new URL("/", site).href },
  { name: sectionName(section), url: new URL(`/${section}`, site).href },
];
if (current !== section) {
  crumbs.push({ name: title, url: new URL(`/${current}/`, site).href });
}
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};
---

<Base title={`${title} — Min-Mozhi docs`} description={metaDescription}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <Nav />
  <div class:list={["docs-shell", { "has-toc": hasToc }]}>
    {/* Below lg the sidebar column is hidden, which until now left phones with
        no chapter navigation at all. Native <details>, same pattern as the top
        nav drawer, rendering the very same Sidebar component. */}
    <details class="docs-drawer lg:hidden">
      <summary>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        Chapters
      </summary>
      <div class="docs-drawer-panel">
        <Sidebar current={current} sections={sections} track={track} />
      </div>
    </details>

    <aside class="docs-aside">
      <div class="docs-sticky">
        <Sidebar current={current} sections={sections} track={track} />
      </div>
    </aside>

    <main data-pagefind-body class="prose docs-main" id="top">
      <Breadcrumb current={current} title={title} track={track} />
      {/* honesty notices stay exactly here */}
      {
        isHonesty && isHonestyHub && (
          <Callout variant="strong">
            <p>
              <strong>A note on accuracy.</strong> I am not a hardware/HDL domain expert.
              My background is adjacent to this field and I know the basics and most of
              the concepts — but roughly <strong>60% of the general HDL material here is
              researched and referenced from the internet</strong>, so it may not be
              accurate 😅
            </p>
            <p>
              <strong>Everything Min-Mozhi-specific is highly accurate</strong>, because I
              built it. Treat the general hardware and HDL background as a friendly
              introduction worth verifying, and the Min-Mozhi material as authoritative.
            </p>
          </Callout>
        )
      }
      {
        isHonesty && !isHonestyHub && (
          <Callout variant="slim">
            General HDL material here is researched from the internet and may be
            inaccurate — everything Min-Mozhi-specific is not. <a href="/learn">Why &rarr;</a>
          </Callout>
        )
      }
      <slot />
      <Pager prev={prev} next={next} />
      <div class="page-meta" data-pagefind-ignore>
        <a href={editUrl} rel="noopener">Edit this page</a>
        {updated && <span>Last updated {updated}</span>}
      </div>
    </main>

    {
      hasToc && (
        <aside class="docs-toc">
          <div class="docs-sticky">
            <Toc headings={headings} />
          </div>
        </aside>
      )
    }
  </div>

  {hasToc && <TocSpy client:idle />}

  <Footer />

  <LiveWaveformMount client:only="react" sources={stdSources} />
</Base>
