// Min-Mozhi example: clocked cover — a functional-coverage hit counter checked once per triggering edge.
// Stripped from synthesis (`ifndef SYNTHESIS` in the emitted Verilog); active in simulation.

module CoverCounter {
  clock clk
  reset rst
  out count: bits[4]

  reg count_r: bits[4] = 0

  on rise(clk) {
    cover(count_r == 15, "counter reached its max value")
    count_r <- count_r +% 1
  }

  count = count_r
}
