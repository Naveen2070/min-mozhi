// Min-Mozhi example: combinational cover — a functional-coverage hit counter checked every settled state.
// Stripped from synthesis (`ifndef SYNTHESIS` in the emitted Verilog); active in simulation.

module Divider {
  in a: bits[8]
  in b: bits[8]
  out q: bits[8]

  cover(b == 0, "divisor was zero")
  q = a
}
