// Min-Mozhi example: clocked assert — a hard invariant checked once per triggering edge.
// Stripped from synthesis (`ifndef SYNTHESIS` in the emitted Verilog); active in simulation.

module AssertCounter {
  clock clk
  reset rst
  out count: bits[4]

  reg count_r: bits[4] = 0

  on rise(clk) {
    assert(count_r < 15, "counter must never exceed its declared width")
    count_r <- count_r +% 1
  }

  count = count_r
}
