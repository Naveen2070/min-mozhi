// Min-Mozhi example (mixed flavors — English, Tanglish, and Tamil keywords in
// one file; mixing freely is the migration path): expose an enum's on-wire
// bit pattern with `encoding`. A debug/bring-up port that shows the current
// FSM state as a plain number — the single most common real-world need for
// enum->bits: routing state to LEDs, a logic-analyzer header, or a
// host-readable status register without attaching a full debugger.

module StateDebug {
  thudippu clk
  மீட்டமை rst

  veliyeedu state_bits: bits[2]

  enum Light { Red, Green, Blue }

  பதிவேடு state: Light = Light.Red

  போது ஏற்றம்(clk) {
    state <- thernthedu state {
      Light.Red   => Light.Green
      Light.Green => Light.Blue
      Light.Blue  => Light.Red
    }
  }

  state_bits = encoding(state)
}

sodhanai "state_bits tracks the FSM's encoding" க்காக StateDebug {
  rst = 1
  kanam(clk)
  rst = 0
  uruthisei state_bits == 0
  tick(clk)
  உறுதிசெய் state_bits == 1
  kanam(clk)
  expect state_bits == 2
  tick(clk)
  uruthisei state_bits == 0
}
