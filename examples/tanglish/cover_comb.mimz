// Min-Mozhi example (Tanglish flavor — same grammar, only the keywords change): combinational cover — a functional-coverage hit counter checked every settled state.
// Stripped from synthesis (`ifndef SYNTHESIS` in the emitted Verilog); active in simulation.

thoguthi Divider {
  ulleedu a: bits[8]
  ulleedu b: bits[8]
  veliyeedu q: bits[8]

  alavidu(b == 0, "divisor was zero")
  q = a
}
