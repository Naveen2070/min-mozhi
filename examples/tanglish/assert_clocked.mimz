// Min-Mozhi example (Tanglish flavor — same grammar, only the keywords change): clocked assert — a hard invariant checked once per triggering edge.
// Stripped from synthesis (`ifndef SYNTHESIS` in the emitted Verilog); active in simulation.

thoguthi AssertCounter {
  thudippu clk
  meettamai rst
  veliyeedu count: bits[4]

  pathivedu count_r: bits[4] = 0

  pothu yetram(clk) {
    valiyuruthu(count_r < 15, "counter must never exceed its declared width")
    count_r <- count_r +% 1
  }

  count = count_r
}
