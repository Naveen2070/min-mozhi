// `mimz ir` CLI fixture: a bundle-typed wire driven by a bundle-returning
// `fn` hits an IR limitation (`unimplemented!` in ir::lower): elaborate drives
// each field wire from `make(v).<field>`, which lowering cannot slice yet, so
// the report underlines `make(v)`. Checks clean; compiles to Verilog.
bundle Handshake(W: int = 8) {
  valid: bit
  data:  bits[W]
}

fn make(v: bit) -> Handshake(W: 8) {
  { valid: v, data: 0 }
}

module Top {
  in  v: bit
  out o: bit
  wire h: Handshake(W: 8) = make(v)
  o = h.valid
}
