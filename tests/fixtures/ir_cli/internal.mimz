// `mimz ir` CLI fixture: an internal compiler error. The checker accepts a
// LIVE read of instance `s[-1]` at `i == 0` (the condition does not fold), so
// ir::lower finds no driver for `s__-1_y` and panics on a broken invariant
// (gaps.md, "the checker accepts an out-of-range instance-array index").
// Replace this fixture with another Internal reproducer once that is fixed.
module Pass {
  in  x: bit
  out y: bit
  y = x
}

module Top {
  in  a: bits[4]
  out o: bits[4]
  repeat i: 0..4 {
    let s[i] = Pass() { x: a[i] }
    o[i] = if a[3] { 0 } else { s[i - 1].y }
  }
}
